# Company metadata
COMPANY_NAME="Acme Corp"

# Data paths (optional; defaults provided)
DATA_DIR="/workspace/data"
KB_PATH="/workspace/data/knowledge_base.json"
RULES_PATH="/workspace/data/rules.json"
PROMPTS_DIR="/workspace/prompts"

# Optional: OpenAI (only if you want LLM refinement)
OPENAI_API_KEY=""
USE_OPENAI="false"

# Gmail OAuth2 credentials (Desktop Application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# For installed apps, localhost redirect is fine
GOOGLE_REDIRECT_URI="http://localhost"

# Optional: default user email for Gmail API (usually "me")
GMAIL_USER_ID="me"